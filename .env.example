# CivicHero Phase 2 Environment Variables
# Do not include real values in this example file.

# Firebase Web SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Platform Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini API Key (Server-Side Only Secret)
APP_GEMINI_API_KEY=
GEMINI_API_KEY=

# Nemotron API Key (Server-Side Only Secret)
NEMOTRON_API_KEY=

# Configurable Copilot Briefing TTL in milliseconds (e.g. 15 minutes = 900000)
COPILOT_TTL_MS=
